# The browser container's host firewall (ADR 0006): public internet only; and the way from Pi's bridge to the bot's
# forwarder, through the INPUT rules Oracle's image ships. It goes in before Docker starts, so the browser, which Docker
# brings back at boot, never runs without it, and after netfilter-persistent, which would flush the INPUT rule. See
# ops/firewall. Installed by ops/install.
[Unit]
Description=Keep the Assistant's browser container on the public internet
Before=docker.service
After=netfilter-persistent.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/assistant/lab1/ops/firewall apply

[Install]
WantedBy=multi-user.target
