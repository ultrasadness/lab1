{
  "name": "lab1-assistant",
  "private": true,
  "type": "module",
  "description": "The growing personal Assistant: the bot, our Pi extension, the VM's ops scripts, the doc-pair check and their tests.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bot/src/main.ts",
    "typecheck": "tsc -p .",
    "test": "node --test --test-timeout=60000 --test-force-exit ${TEST_NAME:+--test-name-pattern=\"$TEST_NAME\"} ${TEST_RECORD:+--test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test-times.ts --test-reporter-destination=$TEST_RECORD} ${TEST_FILES:-'bot/test/**/*.test.ts' 'ops/test/**/*.test.ts' 'scripts/**/*.test.ts'}",
    "check:docs": "node scripts/check-docs.ts",
    "check:shell": "node scripts/check-shell.ts",
    "check:source": "node --test scripts/bot-imports.test.ts scripts/bot-test-imports.test.ts scripts/bot-test-store.test.ts scripts/bounded-waits.test.ts",
    "capture:producthunt-schema": "node scripts/capture-producthunt-schema.ts",
    "capture:new-api": "node scripts/capture-new-api.ts",
    "ticket": "node scripts/ticket.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "graphql": "17.0.2",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  }
}
