{
  "name": "lab1-assistant",
  "private": true,
  "type": "module",
  "description": "The growing personal Assistant: the bot, our Pi extension and their tests.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bot/src/main.ts",
    "typecheck": "tsc -p .",
    "test": "node --test --test-timeout=60000 --test-force-exit \"bot/test/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  }
}
