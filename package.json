{
  "name": "lab1-assistant",
  "private": true,
  "type": "module",
  "description": "The growing personal Assistant: the bot, our Pi extension, the VM's ops scripts, the doc-pair check and their tests.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bot/src/main.ts",
    "typecheck": "tsc -p .",
    "test": "node --test ${TEST_SHARD:+--test-shard=$TEST_SHARD} --test-timeout=60000 --test-force-exit \"bot/test/**/*.test.ts\" \"ops/test/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check:docs": "node scripts/check-docs.ts",
    "check:shell": "node scripts/check-shell.ts",
    "capture:producthunt-schema": "node scripts/capture-producthunt-schema.ts",
    "ticket": "node scripts/ticket.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "graphql": "17.0.2",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  }
}
