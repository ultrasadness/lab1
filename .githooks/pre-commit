#!/bin/sh
# Runs before each commit once `git config core.hooksPath .githooks` turns it on (docs/hooks-and-ci.md). It keeps the
# main checkout on main, as CLAUDE.md asks, and refuses a commit whose staged files fail the bot's typecheck or the
# browser service's, or leave a doc pair out of step (docs/agents/doc-pairs.md). The browser service's tests build an
# image, so they are left to CI (.github/workflows/browser.yml).
set -eu

# Git runs a hook at the top of the working tree. A linked worktree has a git dir of its own; the main checkout
# shares the common one. A detached HEAD, as in the middle of a rebase, is let through.
branch=$(git symbolic-ref --short -q HEAD || true)
if [ "$(git rev-parse --path-format=absolute --git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] &&
  [ -n "$branch" ] && [ "$branch" != main ]; then
  cat >&2 <<EOF
pre-commit: this is the main checkout, which stays on main because other sessions share it, and it is on $branch.
Commit from a worktree of the branch's own. To carry what you staged over, first set it aside in a commit this
hook lets through (the stash is shared with other sessions): git commit --no-verify -m wip. Then:

  git switch main
  git worktree add .claude/worktrees/$branch $branch
  cd .claude/worktrees/$branch

and if you made the wip commit, undo it there with git reset --soft HEAD~1, which leaves its changes staged.
A new branch gets its worktree straight from main: git worktree add .claude/worktrees/<branch> -b <branch> main
EOF
  exit 1
fi

# The packages, as paths from the top: the root, for the bot and the scripts, and browser/, for the browser service.
# Each one's typecheck runs with that package's own dependencies.
set -- '' /browser
missing=
for package in "$@"; do
  [ ! -x "$PWD$package/node_modules/.bin/tsc" ] || continue
  missing="$missing
  $PWD$package"
done
# One refusal names every package missing them. The post-checkout hook installs them in a worktree as it is made.
if [ -n "$missing" ]; then
  echo "pre-commit: the typecheck can't run in a package without its dependencies, and none are installed" \
    "in:$missing" >&2
  echo "Run npm ci in each, then commit again." >&2
  exit 1
fi
# The checks read a copy of what is staged, so unstaged work neither refuses a commit nor hides a broken one. Each
# typecheck runs in its package's directory of that copy, so the paths it names start there.
staged=$(mktemp -d)
trap 'rm -rf "$staged"' EXIT
git checkout-index -a --prefix="$staged/"
for package in "$@"; do
  ln -s "$PWD$package/node_modules" "$staged$package/node_modules"
  if ! (cd "$staged$package" && npm run --silent typecheck) >&2; then
    echo "pre-commit: the typecheck in $PWD$package failed, so the commit is refused." \
      "Fix what it names above, then commit again." >&2
    exit 1
  fi
done
if ! (cd "$staged" && npm run --silent check:docs) >&2; then
  echo "pre-commit: a doc pair is out of step, so the commit is refused. Bring it in line as named above, then commit again." >&2
  exit 1
fi
