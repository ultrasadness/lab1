{
  "dataDir": "/var/lib/assistant",
  "personalDatabase": {
    "dir": "/var/lib/assistant/personal-database",
    "ssh": ["ssh"],
    "retryMinutes": 30
  },
  "discord": {
    "apiBaseUrl": "https://discord.com/api/v10",
    "personUserId": "set at go-live",
    "minerDaysForumId": "set at go-live",
    "statusChannelId": "set at go-live",
    "needsYouChannelId": "set at go-live"
  },
  "productHunt": {
    "apiUrl": "https://api.producthunt.com/v2/api/graphql"
  },
  "gateway": {
    "baseUrl": "http://127.0.0.1:3000/v1"
  },
  "roles": {
    "miner": { "providers": ["openrouter"] }
  },
  "forwarder": {
    "host": "172.17.0.1",
    "port": 8787
  },
  "pi": {
    "command": [
      "docker", "exec", "-i",
      "-e", "ASSISTANT_ROLE", "-e", "ASSISTANT_RUN_KIND", "-e", "ASSISTANT_RUN_TOKEN", "-e", "ASSISTANT_BOT_URL",
      "assistant-pi", "pi-run"
    ],
    "env": {}
  },
  "miner": {
    "startsAt": "01:00",
    "launchesPerRun": 8,
    "lineFloor": 7,
    "catchUpDates": 3,
    "retryMinutes": 30,
    "lateAt": "06:00"
  },
  "runCaps": {
    "miner-judging": { "wallClockMinutes": 10, "turns": 20, "tokens": 200000 },
    "walkthrough-preparation": { "wallClockMinutes": 20, "turns": 40, "tokens": 1000000 },
    "fill": { "wallClockMinutes": 3, "turns": 30, "tokens": 300000 },
    "mail": { "wallClockMinutes": 5, "turns": 10, "tokens": 100000 },
    "question": { "wallClockMinutes": 10, "turns": 40, "tokens": 500000 }
  },
  "rawInputs": {
    "keepDays": 90
  }
}
